# Nguồn dữ liệu phim (mặc định như bên dưới, không cần khai báo nếu không đổi)
KKPHIM_API=https://phimapi.com
KKPHIM_IMG=https://phimimg.com
# VSPHIM_API=https://nguon.vsphim.com/api   (bỏ /api là 404)
# VSPHIM_IMG=https://nguon.vsphim.com
# VSMOV_API=https://vsmov.com/api
# VSMOV_IMG=https://vsmov.com
# TOPXX_API=https://topxx.vip/api/v1   (phải có /v1)
# TOPXX_IMG=https://topxx.vip
# Khoá tài khoản TOPXX (tuỳ chọn, chỉ dùng phía máy chủ)
# TOPXX_API_KEY=
# TOPXX_API_SECRET=

# Proxy /api/hls
# Giới hạn số yêu cầu mỗi phút cho mỗi IP (mặc định 600)
HLS_RATE_LIMIT=600
# Chỉ cho proxy tới các host này (cách nhau bằng dấu phẩy, khớp cả tên miền con). Để trống = cho phép mọi host công khai.
# HLS_ALLOWED_HOSTS=cdn1.example.com,example.net
